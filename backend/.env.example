# ===== 本地环境变量示例（复制为 .env 或直接设置系统环境变量）=====
# 本文件可提交到仓库（不含真实密钥），真实 Key 只放本地。

# DashScope 通义千问 API Key（阿里云百炼平台申请，有免费额度）
# PowerShell 本地运行：
#   $env:DASHSCOPE_API_KEY="sk-你的key"
#   mvn spring-boot:run
DASHSCOPE_API_KEY=

# MySQL（可选，默认 root/root）
DB_USERNAME=root
DB_PASSWORD=root

# JWT 密钥（可选，本地有默认值）
# JWT_SECRET=...
